{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LFMA integrity inventory",
  "type": "object",
  "required": [
    "format",
    "files"
  ],
  "properties": {
    "format": {
      "const": "lfma-artifact-integrity-v1"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
